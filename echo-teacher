const AFFN=DATA.aff.nTotal, EXN=DATA.exam.overall.n;
const CON=['A','B','C','D','E'];
const CONNAME={A:'A 표현 시도·자신감',B:'B 표현 불안',C:'C 표현 의욕·참여',D:'D 자기성찰·조절',E:'E 기여·공동구성'};
const COL={pre:'#bcd0e2',post:'#2f5d8a',gold:'#e0a53a',good:'#5cbfa6',bad:'#d1493a'};
let cur='all';
let charts={};
function destroy(k){if(charts[k]){charts[k].destroy();delete charts[k];}}

// build filter buttons
const affClasses=Object.keys(DATA.aff.n).map(Number).sort((a,b)=>a-b);
const fb=document.getElementById('filter');
function mkBtn(v,label){const b=document.createElement('button');b.textContent=label;b.dataset.v=v;
 b.onclick=()=>{cur=v;render();[...fb.querySelectorAll('button')].forEach(x=>x.classList.toggle('on',x.dataset.v==v));};
 if(v=='all')b.classList.add('on');fb.appendChild(b);}
mkBtn('all','전체');
affClasses.forEach(c=>mkBtn(String(c),c+'반'));

function affData(){return cur=='all'?DATA.aff.overall:(DATA.aff.byClass[cur]||null);}
function affN(){return cur=='all'?DATA.aff.nTotal:(DATA.aff.n[cur]||0);}
function exData(){return cur=='all'?DATA.exam.overall:(DATA.exam.byClass[cur]||null);}

function render(){
 document.getElementById('fhint').textContent = cur=='all'
   ? '전체 학년 집계를 보고 있어요. 반 버튼을 누르면 해당 반만 필터됩니다.'
   : (cur+'반 필터 · 정의적 응답 '+affN()+'명'+(exData()?(' · 시험 성찰 '+exData().n+'명'):' · 시험 성찰 응답 없음'));
 renderAff(); renderExam();
}

function renderAff(){
 const d=affData(), n=affN();
 // KPIs: A,C up ; B down(good); D up
 const dl=(k)=>{const o=d[k];if(!o||o.pre==null||o.post==null)return {v:o&&o.post!=null?o.post:'—',d:''};
   const diff=(o.post-o.pre); return {pre:o.pre,post:o.post,diff:diff};};
 const A=dl('A'),C=dl('C'),B=dl('B'),D=dl('D');
 const arrow=(x)=>x>0?'▲':(x<0?'▼':'–');
 const kp=document.getElementById('affKpis');
 kp.innerHTML=`
 <div class="kpi"><div class="v">${n}<small>명</small></div><div class="l">응답 인원</div></div>
 <div class="kpi"><div class="v up">${A.post}</div><div class="l">A 표현 자신감 (지금)</div><div class="d" style="color:#1f7a44">${arrow(A.diff)} ${A.pre}→${A.post}</div></div>
 <div class="kpi"><div class="v good">${B.post}</div><div class="l">B 표현 불안 (낮을수록 ↑)</div><div class="d" style="color:${B.diff<0?'#1f7a44':'#c0563c'}">${arrow(B.diff)} ${B.pre}→${B.post}</div></div>
 <div class="kpi"><div class="v up">${C.post}</div><div class="l">C 표현 의욕 (지금)</div><div class="d" style="color:#1f7a44">${arrow(C.diff)} ${C.pre}→${C.post}</div></div>`;
 // grouped bar
 destroy('aff');
 const labels=CON.map(k=>CONNAME[k]);
 const pre=CON.map(k=>d[k]?d[k].pre:null);
 const post=CON.map(k=>d[k]?d[k].post:null);
 charts.aff=new Chart(document.getElementById('cAff'),{type:'bar',
  data:{labels,datasets:[
   {label:'3월의 나',data:pre,backgroundColor:COL.pre,borderRadius:5},
   {label:'지금의 나',data:post,backgroundColor:CON.map(k=>k=='B'?COL.good:COL.post),borderRadius:5}]},
  options:{responsive:true,maintainAspectRatio:false,scales:{y:{min:1,max:4,ticks:{stepSize:1}}},
   plugins:{legend:{position:'top'},tooltip:{callbacks:{afterBody:(it)=>it[0].label.startsWith('B')?'※ 낮을수록 좋음(불안 감소)':''}}}}});
 // radar (pre vs post, B->5-B comfort)
 destroy('radar');
 const rlab=['자신감(A)','편안함(5−B)','참여의욕(C)','자기성찰(D)','기여(E)'];
 const rpre=[d.A&&d.A.pre!=null?d.A.pre:null, d.B&&d.B.pre!=null?+(5-d.B.pre).toFixed(2):null, d.C&&d.C.pre!=null?d.C.pre:null, d.D&&d.D.pre!=null?d.D.pre:null, d.E&&d.E.pre!=null?d.E.pre:null];
 const rv=[d.A?d.A.post:null, d.B?+(5-d.B.post).toFixed(2):null, d.C?d.C.post:null, d.D?d.D.post:null, d.E?d.E.post:null];
 charts.radar=new Chart(document.getElementById('cRadar'),{type:'radar',
  data:{labels:rlab,datasets:[
   {label:'3월의 나',data:rpre,backgroundColor:'rgba(188,208,226,.25)',borderColor:COL.pre,pointBackgroundColor:COL.pre,borderWidth:2,spanGaps:true},
   {label:'지금의 나',data:rv,backgroundColor:'rgba(47,93,138,.15)',borderColor:COL.post,pointBackgroundColor:COL.post,borderWidth:2}]},
  options:{responsive:true,maintainAspectRatio:false,scales:{r:{min:1,max:4,ticks:{stepSize:1,font:{size:9}}}},plugins:{legend:{display:true,position:'top'}}}});
 // quotes filtered
 fillQuotes('qMeta',QMETA.filter(q=>cur=='all'||q[0]==cur),q=>`<span class="cl">${q[0]}반</span><span class="qt">"${q[1]}"</span> — ${q[2]}`,'metaphor');
 fillQuotes('qChange',QCHANGE.filter(q=>cur=='all'||q[0]==cur),q=>`<span class="cl">${q[0]}반</span>${q[1]}`);
}

function fillQuotes(id,arr,fmt,mode){
 const el=document.getElementById(id);
 if(!arr.length){el.innerHTML='<div class="empty">이 반의 대표 응답이 아직 없어요</div>';return;}
 el.innerHTML=arr.slice(0,mode=='metaphor'?5:6).map(q=>`<div class="q">${fmt(q)}</div>`).join('');
}

function renderExam(){
 const d=exData(), grid=document.getElementById('exGrid'), kp=document.getElementById('exKpis');
 if(!d){kp.innerHTML=`<div class="kpi" style="grid-column:1/-1"><div class="v">—</div><div class="l">${cur}반은 「시험 이야기」 설문 응답이 없어요 (2·3·6반만 실시)</div></div>`;
   grid.style.opacity=.35;destroy('sat');destroy('q');destroy('learn');
   document.getElementById('qLink').innerHTML='<div class="empty">해당 반 응답 없음</div>';
   document.getElementById('exInsight').innerHTML='';
   document.getElementById('qLearn').innerHTML='';document.getElementById('learnInsight').innerHTML='';return;}
 grid.style.opacity=1;
 kp.innerHTML=`
  <div class="kpi"><div class="v">${d.n}<small>명</small></div><div class="l">응답 인원</div></div>
  <div class="kpi"><div class="v">${d.satMean}<small>%</small></div><div class="l">평균 만족도</div></div>
  <div class="kpi"><div class="v">${(d.dist['81-100']||0)}<small>명</small></div><div class="l">만족도 81~100%</div></div>
  <div class="kpi"><div class="v">${topQ(d.q)}</div><div class="l">최다 언급 문항</div></div>`;
 destroy('sat');
 const order=['0-20','21-40','41-60','61-80','81-100'];
 charts.sat=new Chart(document.getElementById('cSat'),{type:'bar',
  data:{labels:order.map(x=>x+'%'),datasets:[{data:order.map(k=>d.dist[k]||0),
   backgroundColor:['#d1493a','#ec8b43','#f0c659','#7aa8d0','#2f8a55'],borderRadius:5}]},
  options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{ticks:{stepSize:2}}}}});
 destroy('q');
 const qs=Object.entries(d.q).map(([k,v])=>[+k,v]).sort((a,b)=>b[1]-a[1]).slice(0,8);
 charts.q=new Chart(document.getElementById('cQ'),{type:'bar',
  data:{labels:qs.map(([k])=>k+'번 '+(QLABEL[k]||'')),datasets:[{data:qs.map(([,v])=>v),
   backgroundColor:qs.map(([k])=>k==26?COL.gold:COL.post),borderRadius:5}]},
  options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{ticks:{stepSize:5}}}}});
 fillQuotes('qLink',QLINK.filter(q=>cur=='all'||q[0]==cur),q=>`<span class="cl">${q[0]}반</span>${q[1]}`,'link');
 const l=document.getElementById('qLink');[...l.children].forEach(c=>c.classList.add('gold'));
 const t=topQ(d.q);
 document.getElementById('exInsight').innerHTML=`<b>환류의 증거</b> — 가장 많이 기억된 문항은 <b>${t}</b>. 특히 <b>26번(우리 반 설문조사 결과)</b>은 학생들이 직접 참여해 만든 데이터가 그대로 시험에 나온 문항으로, "내가 만든 표현이 수업·평가로 되돌아온다"는 ECHO 환류 구조를 학생들이 스스로 인식하고 있음을 보여줍니다.`;
 renderLearn();
}
function renderLearn(){
 const single=(cur=='2'||cur=='3'||cur=='6');
 const val=(m)=>single?(m.by[cur]||0):m.all;
 const rows=LEARNMAP.map(m=>({...m,c:val(m)})).filter(m=>m.c>0).sort((a,b)=>b.c-a.c);
 destroy('learn');
 charts.learn=new Chart(document.getElementById('cLearn'),{type:'bar',
  data:{labels:rows.map(m=>m.cat+' · '+m.learn),datasets:[{data:rows.map(m=>m.c),
   backgroundColor:rows.map(m=>m.cat=='우리 반 설문조사'?COL.gold:COL.post),borderRadius:5}]},
  options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},
   tooltip:{callbacks:{label:(it)=>it.raw+'명이 배움으로 기억'}}},scales:{x:{ticks:{stepSize:single?2:5}}}}});
 const top=rows[0];
 const qs=top.quotes.filter(q=>!single||q[0]==cur);
 document.getElementById('qLearn').innerHTML = qs.length
   ? qs.slice(0,4).map(q=>`<div class="q gold"><span class="cl">${q[0]}반 ${q[1]}</span>${q[2]}</div>`).join('')
   : '<div class="empty">이 반의 대표 응답이 아직 없어요</div>';
 const scope=single?cur+'반에서':'세 반 전체에서';
 document.getElementById('learnInsight').innerHTML=`<b>가장 오래 남은 배움</b> — ${scope} 가장 많은 학생이 배움으로 꼽은 활동은 <b>${top.cat}</b>(${top.c}명, ${top.learn})이었습니다. 교사가 일방적으로 전달한 지식이 아니라 <b>아이들이 직접 만들고 참여한 수업</b>이 가장 깊게 남았다는 뜻입니다.`;
}
function topQ(q){const e=Object.entries(q).map(([k,v])=>[+k,v]).sort((a,b)=>b[1]-a[1]);return e.length?e[0][0]+'번':'—';}

render();
</script>
</body></html>